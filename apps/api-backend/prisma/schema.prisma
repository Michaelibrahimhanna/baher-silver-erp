// =============================================================================
// BAHER SILVER MANUFACTURING ERP — PRISMA SCHEMA
// Specialized exclusively for Baher Silver Factory (NO GOLD)
// Primary Weight: GRAMS (g) | Secondary Weight: CARATS (ct - display only)
// Phase 15: Relational & Configurable Master Data Hierarchy
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// -----------------------------------------------------------------------------
// 1. RELATIONAL MASTER DATA HIERARCHY & DEPENDENCIES
// -----------------------------------------------------------------------------

model MasterItem {
  id          String   @id @default(uuid())
  parentId    String?  // Parent ID for Category -> Type -> Family -> Variant
  category    String   // 'STONE_CATEGORY' | 'STONE_TYPE' | 'COLOR' | 'SHAPE' | 'SIZE' | 'ORIGIN' | 'QUALITY_GRADE' | 'TREATMENT' | 'SILVER_PURITY' | 'RAW_CATEGORY' | 'UNIT' | 'WAREHOUSE_TYPE' | 'STONE_FAMILY'
  code        String   
  nameAr      String
  nameEn      String
  description String?
  metadata    String?  // JSON metadata for Quality standards, Allowed cuts/colors, Shape-Size link
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   MasterItem?  @relation("MasterHierarchy", fields: [parentId], references: [id])
  children MasterItem[] @relation("MasterHierarchy")

  @@unique([category, code])
}

// -----------------------------------------------------------------------------
// 2. SUPPLIER PROFILES (PROFILES & SRM)
// -----------------------------------------------------------------------------

model SupplierProfile {
  id                     String   @id @default(uuid())
  supplierCode           String   @unique
  companyNameAr          String
  companyNameEn          String
  contactPerson          String?
  phone                  String?
  email                  String?
  country                String   @default("تايلاند")
  currency               String   @default("USD")
  defaultStoneCategories String?  // JSON Array or comma separated
  defaultRawCategories   String?  // JSON Array or comma separated
  paymentTerms           String   @default("Net 30") // Net 30, Cash on Delivery, 50% Advance
  leadTimeDays           Int      @default(14)
  rating                 Float    @default(5.0)
  certificates           String?  // GIA, AIGS, ISO certified
  preferredWarehouseId   String?
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// 3. MULTI-LEVEL PRICING PROFILES
// -----------------------------------------------------------------------------

model ItemPriceProfile {
  id           String   @id @default(uuid())
  itemId       String   // Stone ID or Item ID
  profileType  String   // 'RETAIL' | 'WHOLESALE' | 'VIP' | 'EXPORT' | 'FACTORY'
  pricePerGram Float    @default(0.0)
  pricePerPiece Float   @default(0.0)
  pricePerCarat Float   @default(0.0)
  currency     String   @default("EGP")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([itemId, profileType])
}

// -----------------------------------------------------------------------------
// 4. COMPANY & USER MANAGEMENT
// -----------------------------------------------------------------------------

model Company {
  id                 String   @id @default(uuid())
  companyCode        String   @unique
  nameAr             String
  nameEn             String
  taxNumber          String?
  currencyCode       String   @default("EGP")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  warehouses        Warehouse[]
  storageLocations  StorageLocation[]
  itemsGemstone     ItemGemstone[]
  itemsRawMaterials ItemRawMaterial[]
  itemsSilver       ItemSilver[]
  itemsChemical     ItemChemical[]
  itemsComponent    ItemComponent[]
  movements         StockMovement[]
  audits            InventoryAudit[]
}

model User {
  id                   String            @id @default(uuid())
  username             String            @unique
  email                String?           @unique
  phone                String?
  fullNameAr           String
  fullNameEn           String?
  passwordHash         String
  branchId             String?           @default("BRANCH-MAIN")
  warehouseId          String?           @default("wh-finished")
  department           String?           @default("إدارة المصنع")
  position             String?           @default("مدير نظام")
  profileImage         String?
  status               String            @default("ACTIVE") // ACTIVE | DISABLED
  isSystemUser         Boolean           @default(false)
  isTwoFactorEnabled   Boolean           @default(false)
  twoFactorSecret      String?
  mustChangePassword   Boolean           @default(false)
  isBreakGlassAccount  Boolean           @default(false)
  failedLoginCount     Int               @default(0)
  lockoutUntil         DateTime?
  lastLoginAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  userRoles            UserRoleAssignment[]
  userPermissions      UserPermissionOverride[]
  sessions             UserSession[]
  loginHistory         LoginHistory[]
  auditLogs            AuthAuditLog[]
  passwordHistory      PasswordHistory[]
  recoveryCodes        UserTwoFactorRecoveryCode[]
}

// -----------------------------------------------------------------------------
// 5. MAIN WAREHOUSE STRUCTURE & HIERARCHICAL STORAGE LOCATIONS
// -----------------------------------------------------------------------------

model Warehouse {
  id            String   @id @default(uuid())
  companyId     String   @default("default-company")
  code          String   @unique
  nameAr        String
  nameEn        String
  type          String   
  securityLevel Int      @default(3)
  capacityPct   Float    @default(0.0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  company          Company           @relation(fields: [companyId], references: [id])
  storageLocations StorageLocation[]
  itemsGemstone    ItemGemstone[]
  itemsRawMaterials ItemRawMaterial[]
  itemsSilver       ItemSilver[]
  itemsChemical     ItemChemical[]
  itemsComponent    ItemComponent[]
}

model StorageLocation {
  id               String   @id @default(uuid())
  companyId        String   @default("default-company")
  warehouseId      String
  parentLocationId String?
  binCode          String   @unique
  locationName     String
  cabinet          String?  
  shelf            String?  
  drawer           String?  
  box              String?  
  bag              String?  
  fullPathAr       String?  
  barcode          String?  @unique
  qrCode           String?  @unique
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  company        Company           @relation(fields: [companyId], references: [id])
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id])
  parentLocation StorageLocation?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id])
  childLocations StorageLocation[] @relation("LocationHierarchy")

  itemsGemstone     ItemGemstone[]
  itemsRawMaterials ItemRawMaterial[]
  itemsSilver       ItemSilver[]
  itemsChemical     ItemChemical[]
  itemsComponent    ItemComponent[]
  lots              StoneLot[]
}

// -----------------------------------------------------------------------------
// 6. STONES STORE MASTER DATA & LOT MANAGEMENT
// -----------------------------------------------------------------------------

model ItemGemstone {
  id                String   @id @default(uuid())
  companyId         String   @default("default-company")
  warehouseId       String
  storageLocationId String?
  code              String   @unique
  internalCode      String?  
  qrCode            String?  @unique
  barcode           String?  @unique
  category          String   
  stoneType         String   
  nameAr            String   
  nameEn            String   
  color             String   
  shape             String   
  cut               String?  
  size              String   
  quality           String   
  treatment         String   
  origin            String   
  quantity          Int      @default(0)
  weightGrams       Float    @default(0.0) // PRIMARY WEIGHT IN GRAMS
  weightCarats      Float    @default(0.0) // SECONDARY WEIGHT IN CARATS
  supplierName      String?  
  invoiceNumber     String?  
  batchNumber       String?  
  purchasePrice     Float    @default(0.0)
  sellingPrice      Float    @default(0.0)
  purchaseDate      String?  
  imageUrl          String?  
  certificateUrl    String?  
  notes             String?  
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  lots            StoneLot[]
  movements       StockMovement[]
}

model StoneLot {
  id                String   @id @default(uuid())
  stoneId           String
  batchNumber       String   @unique
  supplierName      String?
  purchaseInvoice   String?
  purchaseDate      String?
  purchasePrice     Float    @default(0.0)
  initialQty        Int      @default(0)
  availableQty      Int      @default(0)
  reservedQty       Int      @default(0)
  weightGrams       Float    @default(0.0)
  weightCarats      Float    @default(0.0)
  storageLocationId String?
  createdAt         DateTime @default(now())

  stone           ItemGemstone     @relation(fields: [stoneId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
}

// -----------------------------------------------------------------------------
// 7. RAW MATERIALS WAREHOUSE
// -----------------------------------------------------------------------------

model ItemRawMaterial {
  id                String   @id @default(uuid())
  companyId         String   @default("default-company")
  warehouseId       String
  storageLocationId String?
  itemCode          String   @unique
  batchNumber       String?
  category          String   
  nameAr            String
  nameEn            String
  supplierName      String?
  purchasePrice     Float    @default(0.0)
  unitCost          Float    @default(0.0)
  availableStock    Float    @default(0.0)
  unitOfMeasure     String   @default("g")
  barcode           String?  @unique
  qrCode            String?  @unique
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  movements       StockMovement[]
}

// -----------------------------------------------------------------------------
// 8. SILVER INVENTORY
// -----------------------------------------------------------------------------

model ItemSilver {
  id                String   @id @default(uuid())
  companyId         String   @default("default-company")
  warehouseId       String   @default("wh-silver")
  storageLocationId String?
  itemCode          String   @unique
  nameAr            String
  nameEn            String?
  batchCode         String?  @unique
  silverCategory    String   @default("فضة خام وسبائك")
  availableStock    Float    @default(0.0)
  unitOfMeasure     String   @default("جرام (g)")
  grossWeightGrams  Float    @default(0.0)
  pureSilverGrams   Float    @default(0.0)
  costPerGram       Float    @default(0.0)
  unitCost          Float    @default(65.0)
  supplierName      String?
  barcode           String?  @unique
  qrCode            String?  @unique
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  movements       StockMovement[]
}

// -----------------------------------------------------------------------------
// 8B. CHEMICALS WAREHOUSE
// -----------------------------------------------------------------------------

model ItemChemical {
  id                  String    @id @default(uuid())
  companyId           String    @default("default-company")
  warehouseId         String    @default("wh-chemicals")
  storageLocationId   String?
  itemCode            String    @unique
  nameAr              String
  nameEn              String?
  category            String    @default("أحماض وكيماويات")
  sdsDocumentUrl      String?
  hazardClass         String    @default("CORROSIVE_8")
  concentration       String    @default("68%")
  storageTempMin      Float     @default(15)
  storageTempMax      Float     @default(25)
  expiryDate          DateTime?
  availableStockGrams Float     @default(0.0)
  unitCost            Float     @default(100.0)
  supplierName        String?
  barcode             String?   @unique
  qrCode              String?   @unique
  notes               String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  movements       StockMovement[]
}

// -----------------------------------------------------------------------------
// 8C. COMPONENTS WAREHOUSE
// -----------------------------------------------------------------------------

model ItemComponent {
  id                 String   @id @default(uuid())
  companyId          String   @default("default-company")
  warehouseId        String   @default("wh-components")
  storageLocationId  String?
  itemCode           String   @unique
  nameAr             String
  nameEn             String?
  category           String   @default("إكسسوارات فضية")
  weightGrams        Float    @default(0.0)
  compatibleProducts String?  @default("خواتم وسلاسل فضية")
  supplierName       String?
  size               String?  @default("قياسي")
  material           String   @default("فضة 925")
  availableStock     Float    @default(0.0)
  unitCost           Float    @default(25.0)
  barcode            String?  @unique
  qrCode             String?  @unique
  notes              String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id])
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id])
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id])
  movements       StockMovement[]
}

// -----------------------------------------------------------------------------
// 9. IMMUTABLE MOVEMENT LEDGER
// -----------------------------------------------------------------------------

model StockMovement {
  id             String   @id @default(uuid())
  companyId      String   @default("default-company")
  txType         String   
  itemType       String   
  itemId         String
  itemCode       String
  itemName       String
  batchNumber    String?
  fromWarehouse  String?
  fromLocation   String?
  toWarehouse    String?
  toLocation     String?
  quantity       Int      @default(0)
  weightGrams    Float    @default(0.0)
  balanceBefore  Float    @default(0.0)
  balanceAfter   Float    @default(0.0)
  referenceDoc   String?  
  userName       String   @default("أمين المخزن")
  notes          String?
  createdAt      DateTime @default(now())

  stoneId        String?
  rawMaterialId  String?
  silverId       String?
  chemicalId     String?
  componentId    String?

  company        Company          @relation(fields: [companyId], references: [id])
  stone          ItemGemstone?    @relation(fields: [stoneId], references: [id], onDelete: SetNull)
  rawMaterial    ItemRawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)
  silver         ItemSilver?      @relation(fields: [silverId], references: [id], onDelete: SetNull)
  chemical       ItemChemical?    @relation(fields: [chemicalId], references: [id], onDelete: SetNull)
  component      ItemComponent?   @relation(fields: [componentId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------------------------------
// 10. INVENTORY AUDIT
// -----------------------------------------------------------------------------

model InventoryAudit {
  id                String               @id @default(uuid())
  companyId         String               @default("default-company")
  auditCode         String               @unique
  warehouseName     String
  storageLocation   String?
  auditorName       String
  status            String               @default("COMPLETED")
  createdAt         DateTime             @default(now())
  
  company Company              @relation(fields: [companyId], references: [id])
  items   InventoryAuditItem[]
}

model InventoryAuditItem {
  id                   String         @id @default(uuid())
  auditId              String
  itemCode             String
  itemName             String
  systemQty            Int            @default(0)
  actualQty            Int            @default(0)
  differenceQty        Int            @default(0)
  systemWeightGrams    Float          @default(0.0)
  actualWeightGrams    Float          @default(0.0)
  differenceWeightGrams Float         @default(0.0)
  lastMovementDate     String?
  lastAuditDate        String?
  auditorNotes         String?

  audit InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// 11. PHASE 23: PRODUCT ENGINEERING & BOM ENGINE
// -----------------------------------------------------------------------------

model ProductMaster {
  id                   String   @id @default(uuid())
  productCode          String   @unique
  nameAr               String
  nameEn               String
  category             String   @default("خاتم") // خاتم / قلادة / إسوارة / حلق
  collection           String?  
  silverPurity         String   @default("925") // 925 / 999 / 835
  silverWeightGrams    Float    @default(0.0)
  stoneCount           Int      @default(0)
  stoneWeightGrams     Float    @default(0.0)
  componentWeightGrams Float    @default(0.0)
  rhodiumType          String?  
  ringSizeDefault      String?  
  imageUrls            String?  // JSON array of image URLs
  attachmentUrls       String?  // JSON array of attachment URLs
  manufacturingNotes   String?  
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  bom        ProductBOM?
  variants   ProductVariant[]
  routing    RoutingTemplate?
  cost       ProductCost?
  physicalPieces PhysicalPiece[]
}

model ProductBOM {
  id                 String    @id @default(uuid())
  productId          String    @unique
  expectedYield      Float     @default(100.0) // Percentage
  expectedLossPercent Float    @default(2.0)   // Expected loss %
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  product ProductMaster @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines   BOMLine[]
}

model BOMLine {
  id           String     @id @default(uuid())
  bomId        String
  lineType     String     // SILVER | STONE | COMPONENT | CHEMICAL | PACKAGING | EXPECTED_LOSS
  itemId       String?    // Reference to Stone, RawMaterial, Silver, etc.
  itemCode     String
  itemName     String
  quantity     Float      @default(1.0)
  unitOfMeasure String    @default("g")
  unitCost     Float      @default(0.0)
  totalCost    Float      @default(0.0)
  wasteFactor  Float      @default(0.0) // Loss % specific to this component
  notes        String?
  createdAt    DateTime   @default(now())

  bom ProductBOM @relation(fields: [bomId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  variantCode   String   @unique
  ringSize      String?
  stoneColor    String?
  stoneSize     String?
  silverPurity  String?
  surfaceFinish String?
  priceDelta    Float    @default(0.0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product ProductMaster @relation(fields: [productId], references: [id], onDelete: Cascade)
  physicalPieces PhysicalPiece[]
}

model RoutingTemplate {
  id          String   @id @default(uuid())
  productId   String   @unique
  templateName String  @default("المسار القياسي للتصنيع")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product ProductMaster @relation(fields: [productId], references: [id], onDelete: Cascade)
  steps   RoutingStep[]
}

model RoutingStep {
  id             String          @id @default(uuid())
  routingId      String
  sequenceNo     Int
  stage          String          // WAX | TREE | CASTING | CLEANING | STONE_SETTING | POLISHING | QC | HALLMARK | PACKAGING
  laborMinutes   Int             @default(0)
  machineMinutes Int             @default(0)
  laborCostRate  Float           @default(0.0)
  notes          String?
  createdAt      DateTime        @default(now())

  routing RoutingTemplate @relation(fields: [routingId], references: [id], onDelete: Cascade)
}

model ProductCost {
  id            String   @id @default(uuid())
  productId     String   @unique
  materialCost  Float    @default(0.0)
  laborCost     Float    @default(0.0)
  machineCost   Float    @default(0.0)
  overhead      Float    @default(0.0)
  packagingCost Float    @default(0.0)
  actualCost    Float    @default(0.0)
  sellingPrice  Float    @default(0.0)
  profitMargin  Float    @default(0.0)
  calculatedAt  DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product ProductMaster @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// 12. PHASE 23A: ENTERPRISE AUTHENTICATION, HYBRID RBAC + ABAC ENGINE
// -----------------------------------------------------------------------------

model SecurityRole {
  id           String               @id @default(uuid())
  roleCode     String               @unique
  nameAr       String
  nameEn       String
  description  String?
  isSystemRole Boolean              @default(false)
  priority     Int                  @default(10)
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  users        UserRoleAssignment[]
  permissions  RolePermissionMapping[]
}

model PermissionGroup {
  id           String               @id @default(uuid())
  groupCode    String               @unique // INVENTORY, WAREHOUSE, MANUFACTURING, FINANCE, CRM, REPORTS, HR, ADMINISTRATION, SETTINGS
  nameAr       String
  nameEn       String
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())

  permissions  SecurityPermission[]
}

model SecurityPermission {
  id             String                  @id @default(uuid())
  permissionCode String                  @unique // e.g. inventory.view, inventory.create
  groupId        String
  nameAr         String
  nameEn         String
  description    String?
  deletedAt      DateTime?
  createdAt      DateTime                @default(now())

  group          PermissionGroup         @relation(fields: [groupId], references: [id])
  roles          RolePermissionMapping[]
  userOverrides  UserPermissionOverride[]
}

model RolePermissionMapping {
  id           String             @id @default(uuid())
  roleId       String
  permissionId String

  role         SecurityRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   SecurityPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRoleAssignment {
  id        String       @id @default(uuid())
  userId    String
  roleId    String

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      SecurityRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model UserPermissionOverride {
  id           String             @id @default(uuid())
  userId       String
  permissionId String
  grantType    String             // ALLOW | DENY
  createdAt    DateTime           @default(now())

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   SecurityPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
}

model UserSession {
  id                   String   @id @default(uuid())
  userId               String
  refreshTokenHash     String   @unique
  device               String?
  browser              String?
  os                   String?
  ipAddress            String?
  lastActiveAt         DateTime @default(now())
  isRevoked            Boolean  @default(false)
  terminationReason    String?
  terminatedByUserId   String?
  expiresAt            DateTime

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String?
  username   String
  status     String   // SUCCESS | FAILED_PASSWORD | LOCKED | LOGOUT | SUSPICIOUS
  ipAddress  String?
  browser    String?
  device     String?
  os         String?
  city       String?  @default("القاهرة")
  country    String?  @default("مصر")
  timestamp  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AuthAuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String   // LOGIN, LOGOUT, CREATE_USER, UPDATE_PERMISSIONS, DELETE_ROLE, IMPERSONATE, BREAK_GLASS, EXPORT_DATA
  entity       String?
  ipAddress    String?
  userAgent    String?
  status       String   @default("SUCCESS")
  details      String?
  previousHash String?  // Cryptographic hash chaining
  currentHash  String?  // Cryptographic hash chaining
  timestamp    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SecurityPolicyConfig {
  id                      String   @id @default("default-security-policy")
  minLength               Int      @default(8)
  requireUppercase        Boolean  @default(true)
  requireLowercase        Boolean  @default(true)
  requireNumbers          Boolean  @default(true)
  requireSpecialChars     Boolean  @default(true)
  maxAgeDays              Int      @default(90)
  preventReuseCount       Int      @default(5)
  lockoutThreshold        Int      @default(5)
  lockoutDurationMinutes  Int      @default(15)
  securityHealthMinimumScore Int   @default(95)
  featureSaasMultiTenant  Boolean  @default(false)
  updatedAt               DateTime @updatedAt
}

model SecurityApprovalRequest {
  id            String   @id @default(uuid())
  requestType   String   // ROLE_CREATE | ROLE_UPDATE | ROLE_DELETE | PERMISSION_OVERRIDE
  targetId      String   // Role ID or User ID
  requestedBy   String
  approvedBy    String?
