// Master PostgreSQL Prisma Schema for Baher Silver ERP System
// Inventory Engine Core (Phase 21)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RecordStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum SystemRole {
  SYSTEM_ADMIN
  FACTORY_MANAGER
  WAREHOUSE_MANAGER
  WAREHOUSE_CLERK
  PURCHASING_OFFICER
  PRODUCTION_MANAGER
  SALES_MANAGER
  QUALITY_CONTROL
  ACCOUNTANT
  VIEWER
}

enum WarehouseType {
  STONES
  SILVER
  RAW_MATERIALS
  CHEMICALS
  COMPONENTS
  SEMI_FINISHED
  FINISHED_GOODS
}

enum AccountCategory {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum BalanceType {
  DEBIT
  CREDIT
}

enum MovementTxType {
  RECEIVE
  ISSUE
  RECEIVE_SILVER
  ISSUE_SILVER
  RECEIVE_RAW
  ISSUE_RAW
  TRANSFER
  ADJUSTMENT
}

model Warehouse {
  id            String        @id @default(uuid())
  code          String        @unique
  nameAr        String
  nameEn        String
  type          WarehouseType
  securityLevel Int           @default(3)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stones       Stone[]
  rawMaterials RawMaterial[]
  silverItems  SilverItem[]

  @@map("warehouses")
}

model StorageLocation {
  id           String   @id @default(uuid())
  binCode      String   @unique
  locationName String
  fullPathAr   String
  cabinet      String?  @default("CAB-01")
  shelf        String?  @default("SHF-01")
  drawer       String?  @default("DRW-01")
  box          String?  @default("BOX-01")
  bag          String?  @default("BAG-01")
  qrCode       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("storage_locations")
}

model Stone {
  id            String       @id @default(uuid())
  code          String       @unique
  nameAr        String
  nameEn        String?
  category      String
  stoneType     String
  origin        String       @default("محلي")
  color         String       @default("طبيعي")
  shape         String       @default("افتراضي")
  size          String       @default("قياسي")
  quality       String       @default("AAA")
  imageUrl      String?
  weightGrams   Float
  quantity      Int
  purchasePrice Float
  sellingPrice  Float
  supplierName  String?
  invoiceNumber String?
  barcode       String?      @unique
  qrCode        String?      @unique
  warehouseId   String
  status        RecordStatus @default(APPROVED)
  isArchived    Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  warehouse Warehouse  @relation(fields: [warehouseId], references: [id])
  movements Movement[]

  @@map("stones")
}

model SilverItem {
  id             String       @id @default(uuid())
  itemCode       String       @unique
  nameAr         String
  nameEn         String?
  category       String       @default("عيار 999 نقي")
  availableStock Float        @default(0)
  unitOfMeasure  String       @default("جرام (g)")
  unitCost       Float        @default(65)
  supplierName   String?
  barcode        String?      @unique
  qrCode         String?      @unique
  warehouseId    String
  status         RecordStatus @default(APPROVED)
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("silver_items")
}

model RawMaterial {
  id             String       @id @default(uuid())
  itemCode       String       @unique
  nameAr         String
  nameEn         String?
  category       String
  availableStock Float        @default(0)
  unitOfMeasure  String       @default("جم")
  unitCost       Float        @default(50)
  supplierName   String?
  warehouseId    String
  status         RecordStatus @default(APPROVED)
  isArchived     Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("raw_materials")
}

model Account {
  id          String          @id @default(uuid())
  code        String          @unique
  nameAr      String
  nameEn      String
  category    AccountCategory
  balanceType BalanceType
  balance     Float           @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  debitEntries  JournalEntry[] @relation("DebitAccount")
  creditEntries JournalEntry[] @relation("CreditAccount")

  @@map("chart_of_accounts")
}

model JournalEntry {
  id                String   @id @default(uuid())
  entryNo           String   @unique
  referenceNo       String
  debitAccountCode  String
  creditAccountCode String
  amount            Float
  description       String
  createdAt         DateTime @default(now())

  debitAccount  Account @relation("DebitAccount", fields: [debitAccountCode], references: [code])
  creditAccount Account @relation("CreditAccount", fields: [creditAccountCode], references: [code])

  @@map("journal_entries")
}

model Movement {
  id                String         @id @default(uuid())
  itemCode          String
  itemName          String
  stoneCategory     String?
  txType            MovementTxType
  typeLabel         String
  quantity          Float
  weightGrams       Float?
  balanceBefore     String
  balanceAfter      String
  recipientEmployee String?
  userName          String         @default("مسؤول المخزن")
  orderNo           String?
  notes             String?
  createdAt         DateTime       @default(now())
  stoneId           String?

  stone Stone? @relation(fields: [stoneId], references: [id])

  @@map("inventory_movements")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  userName   String
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?  @default("127.0.0.1")
  device     String?  @default("Enterprise Terminal")
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}

model NumberingSequence {
  id             String   @id @default(uuid())
  entityType     String   @unique
  prefix         String
  useYear        Boolean  @default(true)
  companyCode    String?  @default("BS")
  branchCode     String?  @default("HQ")
  sequenceLength Int      @default(6)
  currentSeq     Int      @default(1)
  resetPolicy    String   @default("YEARLY")
  lastResetYear  Int?     @default(2026)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("numbering_sequences")
}

model SystemConfig {
  id          String   @id @default(uuid())
  configKey   String   @unique
  configValue String
  category    String   @default("GENERAL")
  description String?
  updatedBy   String   @default("SYSTEM")
  updatedAt   DateTime @updatedAt

  @@map("system_configurations")
}

model LotBatch {
  id              String    @id @default(uuid())
  batchNumber     String    @unique
  entityType      String
  entityId        String
  manufactureDate DateTime  @default(now())
  expiryDate      DateTime?
  initialQuantity Float
  remainingQty    Float
  unitCost        Float
  purityGrade     String?
  supplierId      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("lot_batches")
}

model Attachment {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int?
  uploadedBy String   @default("SYSTEM")
  createdAt  DateTime @default(now())

  @@map("entity_attachments")
}

model Certificate {
  id               String    @id @default(uuid())
  certificateNo    String    @unique
  entityType       String
  entityId         String
  issuer           String
  issueDate        DateTime  @default(now())
  expiryDate       DateTime?
  certificateType  String
  documentUrl      String?
  verificationCode String?
  createdAt        DateTime  @default(now())

  @@map("certificates")
}

model PricingHistory {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  priceType  String
  oldPrice   Float
  newPrice   Float
  currency   String   @default("EGP")
  reason     String?
  changedBy  String   @default("SYSTEM")
  createdAt  DateTime @default(now())

  @@map("pricing_histories")
}

model StockHistory {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  previousStock Float
  changeQty     Float
  newStock      Float
  changeReason  String
  performedBy   String   @default("SYSTEM")
  createdAt     DateTime @default(now())

  @@map("stock_histories")
}

model InventoryBalance {
  id              String   @id @default(uuid())
  entityType      String
  entityId        String
  itemCode        String
  batchNumber     String?
  warehouseId     String
  locationId      String?
  availableQty    Float    @default(0)
  reservedQty     Float    @default(0)
  inProductionQty Float    @default(0)
  damagedQty      Float    @default(0)
  returnedQty     Float    @default(0)
  baseUnit        String   @default("g")
  lastMovementId  String?
  lastMovementAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([entityId, warehouseId, batchNumber, locationId])
  @@map("inventory_balances")
}

model FinishedProduct {
  id                    String       @id @default(uuid())
  productCode           String       @unique
  nameAr                String
  nameEn                String?
  category              String       @default("خاتم فضة")
  billOfMaterialsId     String?
  silverWeightGrams     Float        @default(0)
  silverPurity          String       @default("925")
  stoneWeightGrams      Float        @default(0)
  stoneCount            Int          @default(0)
  componentsWeightGrams Float        @default(0)
  productionRouting     String?      @default("صب ➔ تركيب أحجار ➔ تلميع ➔ دمغ")
  unitCost              Float        @default(0)
  sellingPrice          Float        @default(0)
  barcode               String?      @unique
  qrCode                String?      @unique
  warehouseId           String
  status                RecordStatus @default(APPROVED)
  isArchived            Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("finished_products")
}

model ChemicalItem {
  id                  String       @id @default(uuid())
  itemCode            String       @unique
  nameAr              String
  nameEn              String?
  category            String       @default("أحماض وكيماويات")
  sdsDocumentUrl      String?
  hazardClass         String       @default("CORROSIVE_8")
  concentration       String       @default("68%")
  storageTempMin      Float        @default(15)
  storageTempMax      Float        @default(25)
  expiryDate          DateTime?
  availableStockGrams Float        @default(0)
  unitCost            Float        @default(100)
  supplierName        String?
  warehouseId         String
  status              RecordStatus @default(APPROVED)
  isArchived          Boolean      @default(false)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("chemical_items")
}

model ComponentItem {
  id                 String       @id @default(uuid())
  itemCode           String       @unique
  nameAr             String
  nameEn             String?
  category           String       @default("إكسسوارات فضية")
  weightGrams        Float        @default(0)
  compatibleProducts String?      @default("خواتم وسلاسل فضية")
  supplierName       String?
  size               String?      @default("قياسي")
  material           String       @default("فضة 925")
  availableStock     Float        @default(0)
  unitCost           Float        @default(25)
  warehouseId        String
  status             RecordStatus @default(APPROVED)
  isArchived         Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("component_items")
}
